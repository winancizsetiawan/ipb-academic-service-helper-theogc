# ================================================================
# Frontend environment variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env — it may contain deployment-specific URLs.
# ================================================================

# Backend API base URL (must include /api/v1)
# Local dev: http://127.0.0.1:8000/api/v1
# Production (Railway): https://your-backend.railway.app/api/v1
VITE_API_URL=http://127.0.0.1:8000/api/v1
