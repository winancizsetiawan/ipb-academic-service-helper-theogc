# ================================================================
# Backend environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it contains secrets.
# ================================================================

# PostgreSQL connection string
# Local dev (Docker): postgresql://postgres:postgres@localhost:5433/ipb_help
# Production (Railway): set via Railway environment variables dashboard
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ipb_help

# JWT secret — generate a strong random value for production.
# Example: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_GENERATE_WITH_secrets_token_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS: comma-separated list of allowed frontend origins.
# Production example: https://your-app.vercel.app
# Local dev: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload directory (use absolute path of a Railway persistent volume in prod)
UPLOAD_DIR=uploads

# Demo seeding — set to true ONLY in local/staging environments
ENABLE_DEMO_SEEDING=true

# SMTP (optional — email features are disabled when not configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@apps.ipb.ac.id

# Frontend base URL (used in email links)
BASE_URL=http://localhost:5173

# Demo account emails (only used when ENABLE_DEMO_SEEDING=true)
EMAIL_TEST_MAHASISWA=quina@apps.ipb.ac.id
EMAIL_TEST_STAFF=staff@apps.ipb.ac.id
EMAIL_TEST_ADMIN=admin@apps.ipb.ac.id
